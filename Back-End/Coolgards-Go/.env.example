APP_ENV=development
PORT=4000
DB_ADDRESS=mongodb://mongo:27017/coolgards
DB_NAME=coolgards
# Generate a long random secret; never commit the real value.
SECRET=replace-with-at-least-32-random-characters
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://coolgards.com,https://coolgards.com
MEDIA_DIR=media
COOKIE_SECURE=false

# Optional admin bootstrap (only used when both email/password are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Coolgards Admin

# PayPal
PAYPAL_URL=https://api-m.sandbox.paypal.com
CLIENT_ID=
APP_SECRET=

# SMTP password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
